#usda 1.0
(
    defaultPrim = "FrankensteinAssemblageV7"
    upAxis = "Z"
    metersPerUnit = 1
    timeCodesPerSecond = 24
    startTimeCode = 1
    endTimeCode = 480
    documentation = "GMM Frankenstein assemblage v7 - true PSD colors, opaque, internal spars"
)
# Lineage: Artist Alexander Gonduras Jitomirsky, sole visual authority, with GONVEX/Spark - ADVISORY ONLY
# Ratified directive only - P13 rejected except witness panel
# STYLE LAW: gondurastration paper collage - flat faceted skins front, opaque color-matched grafts behind,
# internal copper spars #f4a261 birds/fish #4cc9f0 cliffs, NO surface wireframe
# Eye rulings: P06 flat red sticker only, P15 silver/paper only, no glassy beads anywhere
# GLB: ../muse_frankenstein/frankenstein_assemblage_stage_v7.glb (relative)
# v7: smooth-shaded + weighted normals, tuck 0.90, amplified act motion, light ramp
# Motion: 24fps 480f hero - 0-4s front collage, 4-12s 32deg oblique reveal, 12-20s macro beak-tail wriggle
def Scope "FrankensteinAssemblage" (
)
    def Xform "P10_cloud" (
        string family = "P10_cloud"
        color3f[] primvars:emission = [(0.792, 0.816, 0.776)]
    )
    def Xform "P11_far" (
        string family = "P11_far"
        color3f[] primvars:emission = [(0.282, 0.259, 0.188)]
    )
