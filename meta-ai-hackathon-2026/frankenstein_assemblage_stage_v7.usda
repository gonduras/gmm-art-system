        color3f[] primvars:emission = [(0.541, 0.431, 0.345)]
    )
    def Xform "P06_orange" (
        string family = "P06_orange"
        color3f[] primvars:emission = [(0.494, 0.318, 0.231)]
    )
    def Xform "P09_botanical" (
