#!/usr/bin/env bash
# Prepares an Amp orb for this repository. Runs once per fresh orb and again on
# stale snapshots, so every step must be idempotent and cheap on a warm filesystem.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
	local name="$1"
	shift
	local start=$SECONDS
	echo "==> $name"
	"$@"
	echo "<== $name ($((SECONDS - start))s)"
}

install_apt_packages() {
	# git-lfs: models/ and data/ are tracked with Git LFS.
	# libgl1, libglib2.0-0: required by OpenCV, which ultralytics pulls in.
	local wanted=(git-lfs libgl1 libglib2.0-0)
	local missing=()
	local pkg
	for pkg in "${wanted[@]}"; do
		dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || missing+=("$pkg")
	done
	if ((${#missing[@]})); then
		sudo apt-get update -qq
		sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}"
	else
		echo "apt packages already installed"
	fi
}

configure_git_lfs() {
	git lfs install --skip-repo >/dev/null
	git lfs install --local >/dev/null
}

install_python_deps() {
	# Orbs have no GPU, so install CPU-only PyTorch wheels instead of the multi-GB CUDA builds.
	[ -x .venv/bin/python ] || uv venv --python 3.11 .venv
	uv pip install --python .venv/bin/python --torch-backend cpu -r requirements.txt
}

persist_venv_on_path() {
	local marker="# gmm-art-system Python virtualenv"
	if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
		cat >>"$HOME/.bash_profile" <<EOF

$marker
case "\$PWD/" in
	"$repo_root"/*)
		export VIRTUAL_ENV="$repo_root/.venv"
		case ":\$PATH:" in
			*":\$VIRTUAL_ENV/bin:"*) ;;
			*) export PATH="\$VIRTUAL_ENV/bin:\$PATH" ;;
		esac
		;;
esac
EOF
	fi
}

step "apt packages" install_apt_packages
step "git lfs" configure_git_lfs
step "python dependencies" install_python_deps
step "shell profile" persist_venv_on_path
